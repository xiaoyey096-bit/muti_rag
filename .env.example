# ====================
# OpenAI / LLM API (DashScope compatible)
# ====================
# 复制本文件为 .env 并填入真实值
OPENAI_API_KEY=sk-替换成你的密钥
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen-flash
LLM_DEFAULT_TEMPERATURE=0.1

# VLM视觉语言模型
VL_MODEL=qwen3-vl-plus
# 商品名识别相关模型
ITEM_MODEL=qwen-flash
# 知识图谱模型
KG_MODEL=qwen-flash

# ====================
# BGE Embedding Models
# ====================
BGE_M3_PATH=E:\ai_models\modelscope_cache\models\BAAI--bge-m3\snapshots\master
BGE_DEVICE=cuda:0
BGE_FP16=True
BGE_RERANKER_LARGE=E:\ai_models\modelscope_cache\models\BAAI--bge-reranker-large\snapshots\master
BGE_RERANKER_DEVICE=cuda:0
BGE_RERANKER_FP16=1
ITEM_NAME_DIAG=1

# ====================
# Embedding General
# ====================
EMBEDDING_DIM=1024
EMBEDDING_MODEL=text-embedding-v4

# ====================
# Vector Database (Milvus)
# ====================
MILVUS_URL=http://192.168.174.20:19530
CHUNKS_COLLECTION=dgx_chunks_v1
ITEM_NAME_COLLECTION=dgx_item_names_v1
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.75
# 商品名确认阈值（自然简称 vs 库内全名）
ITEM_NAME_HIGH_CONFIDENCE=0.70

# ====================
# Document Database (MongoDB)
# ====================
MONGO_URL=mongodb://<user>:<password>@192.168.174.20:27017/?authSource=admin
MONGO_DB_NAME=dgx_kb001

# ====================
# Object Storage (MinIO)
# ====================
MINIO_ENDPOINT=192.168.174.20:9000
MINIO_ACCESS_KEY=替换成你的access_key
MINIO_SECRET_KEY=替换成你的secret_key
MINIO_BUCKET_NAME=dgx-knowledge-base-v1

# ====================
# Other / MCP Services
# ====================
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# ==================== MinerU 解析 ====================
MINERU_PYTHON=E:\kb_venv\Scripts\python.exe
MINERU_BACKEND=pipeline
MINERU_DEVICE=cuda:0
MINERU_METHOD=auto
MINERU_SOURCE=local
